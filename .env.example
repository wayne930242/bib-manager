# Production/shared database (Neon or any PostgreSQL provider).
# Copy this file to .env.local and replace the value. Never commit credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Comma-separated browser origins allowed to call the API.
BIB_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
