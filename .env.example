# Production/shared database (Neon or any PostgreSQL provider).
# Copy this file to .env.local and replace the value. Never commit credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Comma-separated browser origins allowed to call the API.
BIB_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4321,https://www.wayneh.tw

# Shared by the API and the blog GitHub Action.
BIB_SYNC_TOKEN=replace-with-a-long-random-token

# Private source-asset sessions. Keep these independent from BIB_SYNC_TOKEN.
BIB_ADMIN_TOKEN=replace-with-a-long-management-password
BIB_SESSION_SECRET=replace-with-at-least-32-random-characters
BIB_ADMIN_SESSION_TTL_SECONDS=28800

# Private Cloudflare R2 bucket. Do not enable r2.dev or a public custom domain.
BIB_R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
BIB_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
BIB_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
BIB_R2_BUCKET=bibliography-private-assets
